# --- SECURITY (CRITICAL) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# --- OS & General ---
.DS_Store
Thumbs.db
.directory

# --- Kotlin / Spring Boot / Gradle ---
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/
# Ignore Gradle GUI config
gradle-app.setting
# Avoid ignoring Gradle wrapper jar
!gradle-wrapper.jar

# --- React / Node.js ---
node_modules/
/dist/
# If using Create-React-App, it uses 'build' which overlaps with Gradle.
# Since Gradle also uses 'build', ignoring 'build/' covers both!
# build/ (Already covered above)

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

