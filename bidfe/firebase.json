{
  "hosting": {
    "public": "dist",
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "bid-your-car",
          "region": "europe-west1"
        }
      },
      {
        "source": "/oauth2/authorization/google",
        "run": {
          "serviceId": "bid-your-car",
          "region": "europe-west1"
        }
      },
      {
        "source": "/login/oauth2/code/google",
        "run": {
          "serviceId": "bid-your-car",
          "region": "europe-west1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}